# ── Database ────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://boundary:boundary_secret@localhost:5432/boundary_surveys

# ── OpenAI ──────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Security ────────────────────────────────────
# Set to 'disabled' to allow unauthenticated access (default for development).
# Set to any other value to require Bearer token authentication on all endpoints.
API_BEARER_TOKEN=disabled

# ── Application ─────────────────────────────────
CORS_ORIGINS=["http://localhost:3000"]
SIMILARITY_THRESHOLD=0.95
RATE_LIMIT=10/minute
LOG_LEVEL=INFO
